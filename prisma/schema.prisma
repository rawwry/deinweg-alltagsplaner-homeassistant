datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Location {
  id                   String        @id @default(cuid())
  name                 String
  address              String?
  defaultSupermarketId String?
  defaultServings      Int           @default(6)
  cookingDays          String        @default("1,2,3,4,5,6,7") // Comma-separated active cooking days (1=Mon ... 7=Sun)
  weeklyBudget         Float         @default(350.0) // Weekly shopping budget in Euro
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  defaultSupermarket   Supermarket?  @relation(fields: [defaultSupermarketId], references: [id])
  users                User[]
  mealPlans            MealPlan[]
  notes                CaregiverNote[]
  wastePickups         WastePickup[]
  customShoppingItems  CustomShoppingItem[]
  weeklyBudgets        LocationWeeklyBudget[]
  savingsTransactions  LocationSavingsTransaction[]
  choreTemplates       ChoreTemplate[]
  choreAssignments     ChoreAssignment[]
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String?
  passwordHash String
  name         String
  role         String        @default("BEWOHNER") // "ADMIN", "BETREUER", "BEWOHNER"
  locationId   String?
  avatarColor  String?       @default("#3b82f6")
  avatarUrl    String?
  birthday     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes        CaregiverNote[] @relation("ResidentNotes")
  authoredNotes CaregiverNote[] @relation("AuthoredNotes")
  noteMessages CaregiverNoteMessage[]
  hiddenNotes  CaregiverNoteHidden[]
  choreAssignments ChoreAssignment[] @relation("ResidentChores")
}

model Supermarket {
  id        String            @id @default(cuid())
  name      String
  isGlobal  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  prices    IngredientPrice[]
  locations Location[]
}

model Ingredient {
  id           String             @id @default(cuid())
  name         String
  category     String             @default("Sonstiges") // Obst & Gemüse, Kühlregal & Milch, Fleisch & Fisch, Trockenwaren & Teigwaren, Gewürze & Saucen, Backwaren, Getränke, Sonstiges
  standardUnit String             @default("g") // g, kg, ml, l, Stück, Dose, Packung, Bund, TL, EL
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  prices            IngredientPrice[]
  recipeIngredients RecipeIngredient[]
}

model IngredientPrice {
  id            String      @id @default(cuid())
  ingredientId  String
  supermarketId String
  pricePerUnit  Float       // e.g. 1.89
  unitSize      Float       @default(1) // e.g. 500 for 500g, or 1 for 1kg / 1 Stück
  unit          String      @default("Stück")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, supermarketId])
}

model Recipe {
  id              String             @id @default(cuid())
  title           String
  description     String?
  instructions    String?
  category        String             @default("Alltagsküche") // Pasta, Fleisch, Geflügel, Vegetarisch, Eintopf, Schnelle Küche, Fisch, Süßspeise
  defaultServings Int                @default(4)
  prepTimeMinutes Int?               @default(30)
  imageUrl        String?
  isArchived      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  ingredients     RecipeIngredient[]
  mealPlanDays    MealPlanDay[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Float
  unit         String
  notes        String?

  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id         String        @id @default(cuid())
  locationId String
  year       Int
  weekNumber Int
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  location   Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  days       MealPlanDay[]

  @@unique([locationId, year, weekNumber])
}

model MealPlanDay {
  id              String    @id @default(cuid())
  mealPlanId      String
  dayOfWeek       Int       // 1 = Montag ... 7 = Sonntag
  recipeId        String?
  customDishTitle String?
  servings        Int       @default(6)
  mealType        String    @default("main") // lunch, dinner, main
  cookUserId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mealPlan        MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe          Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([mealPlanId, dayOfWeek])
}

model ShoppingListItemState {
  id              String    @id @default(cuid())
  locationId      String
  year            Int
  weekNumber      Int
  ingredientId    String
  isChecked       Boolean   @default(false)
  checkedByUserId String?
  checkedAt       DateTime?

  @@unique([locationId, year, weekNumber, ingredientId])
}

model CustomShoppingItem {
  id         String   @id @default(cuid())
  locationId String
  year       Int
  weekNumber Int
  name       String
  amount     Float?
  unit       String?
  category   String   @default("Sonstiges")
  isChecked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model CaregiverNote {
  id                  String    @id @default(cuid())
  locationId          String
  authorId            String?
  residentId          String
  title               String
  content             String
  category            String    @default("ALLGEMEIN") // ALLGEMEIN, ANKUENDIGUNG, HINWEIS, FRAGE, DRINGEND
  isPinned            Boolean   @default(false)
  expiresAt           DateTime?
  status              String    @default("OPEN") // OPEN, IN_PROGRESS, DONE
  isArchived          Boolean   @default(false)
  isPrivate           Boolean   @default(false)
  hasUnreadResponse   Boolean   @default(false)
  caregiverResponse   String?
  respondedAt         DateTime?
  respondedByUserId   String?
  resolvedAt          DateTime?
  resolvedByUserId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  location            Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resident            User      @relation("ResidentNotes", fields: [residentId], references: [id], onDelete: Cascade)
  author              User?     @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: SetNull)
  messages            CaregiverNoteMessage[]
  hiddenBy            CaregiverNoteHidden[]
}

model CaregiverNoteMessage {
  id                  String        @id @default(cuid())
  noteId              String
  authorId            String
  content             String
  createdAt           DateTime      @default(now())

  note                CaregiverNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author              User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CaregiverNoteHidden {
  id                  String        @id @default(cuid())
  noteId              String
  userId              String
  hiddenAt            DateTime      @default(now())

  note                CaregiverNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
}

model WastePickup {
  id         String   @id @default(cuid())
  locationId String
  date       String   // YYYY-MM-DD
  wasteType  String   // REST, BIO, PAPER, YELLOW
  notes      String?
  createdAt  DateTime @default(now())

  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model LocationWeeklyBudget {
  id           String   @id @default(cuid())
  locationId   String
  year         Int
  weekNumber   Int
  budgetAmount Float    // Weekly allocated budget (e.g. 350.0)
  actualSpent  Float?   // Optional actual receipt / shopping receipt total (e.g. 294.50)
  receiptNote  String?  // Optional note (e.g. "Kassenbon REWE")
  isConfirmed  Boolean  @default(false) // Whether caregiver marked week as closed/confirmed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, year, weekNumber])
}

model LocationSavingsTransaction {
  id           String   @id @default(cuid())
  locationId   String
  date         String   // YYYY-MM-DD
  amount       Float    // Positive for deposits, negative for expenditures
  type         String   // "EXPENSE", "DEPOSIT"
  category     String   @default("SONSTIGES") // "AKTIVITAET", "SONDERANSCHAFFUNG", "REPARATUR", "SONSTIGES"
  purpose      String   // Description (e.g. "Kinobesuch WG", "Neuer Toaster")
  recordedById String?
  createdAt    DateTime @default(now())

  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model SmtpSetting {
  id                                     String   @id @default("smtp-default")
  host                                   String   @default("")
  port                                   Int      @default(587)
  secure                                 Boolean  @default(false)
  user                                   String   @default("")
  password                               String   @default("")
  fromEmail                              String   @default("")
  fromName                               String   @default("Dein Weg Alltagsplaner")
  residentReplyTemplateSubject           String   @default("Neue Antwort im Flurfunk: {noteTitle}")
  residentReplyTemplateBody              String   @default("Hallo {residentName},\n\n{responderName} hat auf deinen Flurfunk-Beitrag geantwortet:\n\n\"{replyText}\"\n\nSchau gerne im Alltagsplaner vorbei, um mehr zu erfahren.\n\nViele Grüße,\nDein WG-Team")
  caregiverNotificationTemplateSubject   String   @default("Neue Flurfunk-Nachricht an Betreuer ({locationName}): {noteTitle}")
  caregiverNotificationTemplateBody      String   @default("Hallo Betreuer-Team,\n\n{authorName} hat eine neue Nachricht im Flurfunk ({locationName}) hinterlassen:\n\n\"{noteContent}\"\n\nBitte prüfe die Nachricht im Alltagsplaner.\n\nViele Grüße,\nDein WG-System")
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt
}

model RecipeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChoreTemplate {
  id                  String            @id @default(cuid())
  locationId          String
  title               String            // e.g. "Küche & Abwasch", "Zimmerreinigung"
  description         String?           // Details / guidelines
  icon                String?           @default("🧹") // Emoji / Icon
  sortOrder           Int               @default(0)
  isActive            Boolean           @default(true)
  assignedResidentIds String?           // JSON array string e.g. '["ALL"]' or '["user1","user2"]'
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  location            Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignments         ChoreAssignment[]
}

model ChoreAssignment {
  id                  String         @id @default(cuid())
  locationId          String
  templateId          String
  date                String         // Format: YYYY-MM-DD
  year                Int
  weekNumber          Int
  dayOfWeek           Int            // 1 (Mo) - 7 (So)
  residentId          String?        // Legacy single resident
  assignedResidentIds String?        // JSON array string e.g. '["ALL"]' or '["user1","user2"]'
  completedResidentIds String?       // JSON array string e.g. '["user1","user2"]'
  isCompleted         Boolean        @default(false)
  completedAt         DateTime?
  completedById       String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  location            Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template            ChoreTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  resident            User?          @relation("ResidentChores", fields: [residentId], references: [id], onDelete: SetNull)

  @@unique([locationId, templateId, date])
}
